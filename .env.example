# SupportFlow configuration
#
# Every variable below is OPTIONAL. With no .env file at all the app runs
# fully: an in-memory SQLite database seeded from a fixed seed, and the
# deterministic offline AI provider.
#
# Copy this file to `.env.local` to override anything.
# `.env.local` is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Path to a SQLite file for a database that survives restarts. Leave it unset
# and the database lives in memory and is re-seeded on every start — which is
# what makes the public demo safe: anyone can change anything, and a restart
# puts it back.
# SUPPORTFLOW_DB_FILE=./supportflow.db

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

# HMAC key for the session cookie. Must be at least 16 characters. Without it
# the app falls back to a well-known development secret and logs a warning
# once per process in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# AI assistant
# ---------------------------------------------------------------------------

# With no key the deterministic offline provider is used and the UI labels
# every response as simulated. Set a key to use the real provider instead.
# This value is read only on the server and is never sent to the browser.
# ANTHROPIC_API_KEY=sk-ant-...

# Override the model (defaults to claude-sonnet-4-5).
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Force the offline provider even when a key is present. Useful for demos and
# for CI, where the suite must not make paid API calls.
# AI_PROVIDER=mock

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Run Playwright against an already-running instance instead of starting one.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3200

# Use a pre-installed Chromium instead of the one Playwright downloads.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium/chrome-linux/chrome
